    "ai": "^6.0.283",
    "isbot": "^5.2.2",
    "node-sql-parser": "^5.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
