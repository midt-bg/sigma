{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sigma-etl-dev",
  "main": "src/dev.ts",
  "account_id": "1a40aa4d0d78bed8ecf036dd22fbfa9f",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "REGISTRY_API_BASE_URL": "https://api-sigma-cr.registryagency.bg",
    "REGISTRY_PORTAL_URL": "https://portal.registryagency.bg/CR/api/Applications/Entries",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sigma-dev",
      "database_id": "713b98fa-6ab5-45f3-81c4-119f4c0907d6",
    },
  ],
  "workflows": [
    { "binding": "REGISTRY", "name": "sigma-registry-dev", "class_name": "RegistryWorkflow" },
  ],
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "persist": true },
  },
}
