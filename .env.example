# .env.example — copy to .env.local for *local* provisioning/seeding or a manual `pnpm deploy`:
#   set -a; source .env.local; set +a
#
# IMPORTANT: the CI pipeline does NOT read this file. .github/workflows/deploy.yml pulls these from
# GitHub Environment secrets/variables instead (see docs/deploy.md). If you deploy via CI you do not
# need the credentials below on your machine at all — prefer `wrangler login` for one-off local
# provisioning/seeding. `pnpm dev` runs without any of this (miniflare); the AI assistant is the one
# exception — `ai`/`vectorize` have no local emulation and work in dev only through a remote proxy
# session, which uploads a temporary proxy Worker to the account. It turns on automatically when
# CLOUDFLARE_API_TOKEN is exported; set SIGMA_DEV_REMOTE_BINDINGS=0 to keep dev fully local anyway.

# --- Deploy credentials (CI: GitHub secrets; local: only for a manual `pnpm deploy`) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Target names (deploy render). Leave empty to use the committed production names. ---
# Set these (typically in a GitHub Environment) to deploy a non-prod target like staging.
SIGMA_WEB_NAME=                    # e.g. sigma-stage
SIGMA_ETL_NAME=                    # e.g. sigma-etl-stage
SIGMA_WORKFLOW_NAME=               # e.g. sigma-refresh-stage
SIGMA_REGISTRY_WORKFLOW_NAME=      # e.g. sigma-registry-stage
SIGMA_DECLARATIONS_WORKFLOW_NAME=  # e.g. sigma-declarations-stage
SIGMA_REBUILD_WORKFLOW_NAME=       # e.g. sigma-rebuild-stage
SIGMA_DECLARATIONS_BUCKET=         # e.g. sigma-declarations-stage (R2, etl worker)
SIGMA_CSV_CACHE_NAME=              # e.g. sigma-csv-cache-stage (R2, web worker)
SIGMA_REPORTS_NAME=                # assistant R2 bucket (web worker)
SIGMA_VECTORIZE_NAME=              # assistant Vectorize index (web worker)
# The target environment (production, staging, …): the declarations container refuses a D1 that is
# not allowed for it.
# CI sets it from the GitHub Environment; set it only for a manual deploy.
SIGMA_SHIP_ENV=

# --- D1 name: used by BOTH the bootstrap/import/seed scripts AND the deploy render ---
# Always set it: unset falls back to `sigma`, which is no environment's slot. Production uses
# `sigma-green` / `sigma-blue`, staging `sigma-stage-blue` / `sigma-stage-green` (docs/deploy.md).
SIGMA_D1_NAME=

# D1 database_id printed by `bootstrap.mjs --apply`. The committed wrangler.* keep a zero-UUID dummy
# for local dev; the deploy render substitutes the real id. Per environment.
SIGMA_D1_ID=

# --- Takedown fingerprints (etl worker secrets, docs/runbooks/related-persons-suppression.md) ---
# Per environment, never shared between staging and production. CI sets them from the environment.
SUPPRESSION_SALT=
SUPPRESSION_KEY_VERSION=           # e.g. 1
