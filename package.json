{
  "name": "sigma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "prettier --check .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:test": "node --test scripts/check-docs.test.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:coverage:test": "node --test scripts/check-coverage.test.mjs",
    "check:fake-d1": "node scripts/check-fake-d1.mjs",
    "check:fake-d1:test": "node --test scripts/check-fake-d1.test.mjs",
    "format": "prettier --write .",
    "setup": "node scripts/setup.mjs",
    "import": "node scripts/import.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:apply": "node scripts/bootstrap.mjs --apply",
    "deploy": "turbo run deploy",
    "teardown": "node scripts/teardown.mjs",
    "smoke:slug": "node scripts/smoke-encoded-slug.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@types/node": "catalog:",
    "fast-xml-parser": "5.11.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "wrangler": "catalog:"
  }
}
